# 로컬 실행 프로파일: MySQL 연결
# 이 파일을 application-local.yml로 복사한 뒤 비밀번호를 입력하세요.
# application-local.yml은 .gitignore 대상입니다. 커밋하지 마세요.
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/til?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password:
  h2:
    console:
      enabled: false
  sql:
    init:
      mode: always
      platform: mysql
